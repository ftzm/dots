# Render all environments
render-all: render-lab

# Render lab environment: one directory per namespace (one Tanka inline
# environment each, environments/lab/main.jsonnet), which is one ArgoCD
# Application each. The render itself is the flake's `render-lab` package,
# built in the nix sandbox -- the same derivation CI's `render-lab` check
# compares with the committed manifests, so the two cannot drift. `path:`,
# not the git reference: a chart vendored by Renovate's post-upgrade task is
# still untracked, and a git flake omits untracked files.
# Swap only on success: a failed render must not leave manifests/ empty
# (renovate commits whatever the tree looks like after its post-upgrade
# task, and an empty tree would delete everything).
render-lab:
    #!/usr/bin/env bash
    set -euo pipefail
    trap 'rm -f .render-lab' EXIT
    nix build --no-update-lock-file --out-link .render-lab "path:.#render-lab"
    rm -rf manifests
    cp -rL --no-preserve=mode .render-lab manifests

# Unit-test the rendered Prometheus alert rules.
# Rules ship as PrometheusRule CRs but promtool wants bare rule files, so
# extract .spec into tests/.rules (gitignored) and point the tests at it.
# Testing the rendered output, not the Jsonnet, means a rule that only breaks
# once templated still fails here.
test-rules:
    #!/usr/bin/env bash
    set -euo pipefail
    rm -rf tests/.rules
    mkdir -p tests/.rules
    for f in manifests/*/*-prometheusrule.yaml; do
      yq '.spec' "$f" > "tests/.rules/$(basename "$f")"
    done
    promtool test rules tests/*.test.yaml
    # Loki rules ship as a ConfigMap holding one rule file; lokitool parses the
    # LogQL that promtool cannot. It does not reject a bare log selector, so the
    # metric-query shape is asserted in lib/alerts.libsonnet at render time.
    for f in manifests/*/loki-rule-*-configmap.yaml; do
      out="tests/.rules/$(basename "$f")"
      yq -r '.data | to_entries | .[0].value' "$f" > "$out"
      lokitool rules check --rule-files="$out"
    done

# Initialize jsonnet-bundler dependencies
jb-install:
    jb install

# Update jsonnet-bundler dependencies
jb-update:
    jb update

# Show diff of what would change in lab, one namespace's environment at a
# time (tk diff takes a single environment).
diff-lab:
    #!/usr/bin/env bash
    set -euo pipefail
    for ns in manifests/*/; do
      ns=$(basename "$ns")
      echo "== $ns"
      tk diff environments/lab --name "$ns"
    done

# Generate renovate.json from chartfile.yaml (outputs to repo root)
generate-renovate:
    jsonnet renovate.jsonnet > ../renovate.json
    renovate-config-validator ../renovate.json

# Test renovate config locally (dry-run)
test-renovate:
    RENOVATE_CONFIG_FILE=renovate.json renovate --platform=local --dry-run=full --onboarding=false
