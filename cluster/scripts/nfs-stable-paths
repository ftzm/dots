#!/usr/bin/env bash
# One-time move of dynamically provisioned NFS volumes from the provisioner's
# UID-named directories (<ns>-<pvc>-pvc-<uid>) to the stable names the `nfs`
# StorageClass now provisions (<ns>-<pvc>, its pathPattern), so a rebuilt
# cluster's PVCs find their data (FORGEJO_MIGRATION_PLAN.md -> Cluster
# Bootstrap, found by its rehearsal). The one-time-migration exception to "no
# manual kubectl": each step is undone by the next, and git is unchanged.
#
#   nfs-stable-paths NAMESPACE...
#
# Per namespace, for each UID-named directory on nas that is not a cnpg
# database volume (those are cnpg's; see its own recovery). Resumable: a rerun
# after a failure picks up from what is left.
#   1  pause the namespace's Application (selfHeal would undo the scale-down)
#   2  PV reclaim policy -> Retain, before anything scales (a StatefulSet with
#      whenScaled: Delete deletes its PVC on scale-down)
#   3  scale every workload mounting one to 0 -- through the Prometheus or
#      Alertmanager object when the operator owns the StatefulSet; the
#      original replicas are kept in a ConfigMap until verified
#   4  delete the PVC and PV objects: the data stays on nas, untouched
#   5  rename the directory on nas, in a Job mounting /pool-1/k8s (refuses
#      if the stable name exists)
#   6  restore the replicas, resume and sync: ArgoCD (or the StatefulSet)
#      recreates the PVC, the provisioner reuses the renamed directory
#   7  verify: each new PV's path is the stable one, its file count is the
#      old one's, every workload is ready again
#
# Run in the cluster dev shell, with $KUBECONFIG set.
set -euo pipefail

nas=${NFS_SERVER:-192.168.1.3}
root=/pool-1/k8s
[ $# -gt 0 ] || { echo "usage: $0 NAMESPACE..." >&2; exit 2; }

log() { echo "[$1] $2"; }

# Run a shell script against /pool-1/k8s in a Job in $ns; print its log.
nas_job() {
  local ns=$1 name=$2 script=$3
  kubectl delete job -n "$ns" "$name" --ignore-not-found >/dev/null
  kubectl apply -f - >/dev/null <<EOF
apiVersion: batch/v1
kind: Job
metadata: { name: $name, namespace: $ns }
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 600
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: run
          image: alpine/k8s:1.35.8 # images.alpineK8s
          command: [/bin/sh, -c]
          args: [$(jq -Rs . <<<"$script")]
          volumeMounts: [{ name: k8s, mountPath: /k8s }]
      volumes:
        - { name: k8s, nfs: { server: $nas, path: $root } }
EOF
  local st=''
  for _ in $(seq 100); do
    st=$(kubectl get job -n "$ns" "$name" -o jsonpath='{.status.succeeded}/{.status.failed}')
    case $st in 1/*) break ;; */[1-9]*) break ;; esac
    sleep 3
  done
  kubectl logs -n "$ns" "job/$name"
  [[ $st == 1/* ]] || { echo "nfs-stable-paths: job $name failed ($st)" >&2; exit 1; }
}

for ns in "$@"; do
  # What to move comes from nas, the ground truth: every <ns>-<pvc>-pvc-<uid>
  # directory, minus cnpg's database volumes (<cluster>-<n>). A rerun after a
  # failure resumes from wherever the objects were left.
  skip=$(kubectl get clusters.postgresql.cnpg.io -n "$ns" -o name 2>/dev/null | sed 's|.*/||')
  declare -A old=()
  while read -r dir; do
    pvc=${dir#"$ns"-}
    pvc=${pvc%-pvc-*}
    for c in $skip; do [[ $pvc =~ ^$c-[0-9]+$ ]] && continue 2; done
    old[$pvc]=$dir
  done < <(nas_job "$ns" nfs-stable-paths-list "ls /k8s | grep -E '^$ns-.+-pvc-[0-9a-f-]{36}\$' || true")
  if [ ${#old[@]} -eq 0 ]; then
    log "$ns" "nothing to move"
    unset old
    continue
  fi
  log "$ns" "moving: ${!old[*]}"

  # Workloads mounting them and their replicas, kept in a ConfigMap until
  # verified: a rerun finds them scaled to 0 and must restore the originals.
  state=nfs-stable-paths-state
  declare -A replicas=()
  if kubectl get configmap -n "$ns" "$state" >/dev/null 2>&1; then
    while IFS='=' read -r t r; do replicas[$t]=$r; done < <(kubectl get configmap -n "$ns" "$state" -o json \
      | jq -r '.data | to_entries[] | "\(.key | gsub("_"; "/"))=\(.value)"')
  else
    workloads=$(kubectl get pods -n "$ns" -o json | jq -r --argjson pvcs "$(printf '%s\n' "${!old[@]}" | jq -R . | jq -s .)" '
      .items[] | select([.spec.volumes[]?.persistentVolumeClaim.claimName] | any(. as $c | $pvcs | index($c)))
      | .metadata.ownerReferences[0] | "\(.kind)/\(.name)"' | sort -u)
    for w in $workloads; do
      kind=${w%%/*} name=${w#*/}
      case $kind in
        ReplicaSet) t="deployment/$(kubectl get rs -n "$ns" "$name" -o jsonpath='{.metadata.ownerReferences[0].name}')" ;;
        StatefulSet)
          op=$(kubectl get sts -n "$ns" "$name" -o jsonpath='{.metadata.ownerReferences[0].kind}/{.metadata.ownerReferences[0].name}')
          case $op in
            Prometheus/* | Alertmanager/*) t=${op,,} ;;
            *) t="statefulset/$name" ;;
          esac ;;
        *) echo "nfs-stable-paths: $ns: pod owned by $w, not handled" >&2; exit 1 ;;
      esac
      replicas[$t]=$(kubectl get -n "$ns" "$t" -o jsonpath='{.spec.replicas}')
    done
    args=()
    for t in "${!replicas[@]}"; do args+=(--from-literal="${t//\//_}=${replicas[$t]}"); done
    kubectl create configmap -n "$ns" "$state" "${args[@]}" >/dev/null
  fi
  log "$ns" "workloads: $(for t in "${!replicas[@]}"; do printf '%s=%s ' "$t" "${replicas[$t]}"; done)"

  log "$ns" "1: pause the Application"
  kubectl patch application -n argocd "$ns" --type merge \
    -p '{"spec":{"syncPolicy":{"automated":{"enabled":false}}}}' >/dev/null

  # Before anything scales: a StatefulSet with whenScaled: Delete (loki)
  # deletes its PVC on scale-down, and the PV must not follow.
  log "$ns" "2: PVs to Retain"
  for pvc in "${!old[@]}"; do
    pv=$(kubectl get pv -o json | jq -r --arg ns "$ns" --arg c "$pvc" \
      '.items[] | select(.spec.claimRef.namespace == $ns and .spec.claimRef.name == $c) | .metadata.name')
    [ -n "$pv" ] && kubectl patch pv "$pv" -p '{"spec":{"persistentVolumeReclaimPolicy":"Retain"}}' >/dev/null
  done

  log "$ns" "3: scale to 0: ${!replicas[*]}"
  for t in "${!replicas[@]}"; do
    kubectl patch -n "$ns" "$t" --type merge -p '{"spec":{"replicas":0}}' >/dev/null
  done
  for pvc in "${!old[@]}"; do
    until [ -z "$(kubectl get pods -n "$ns" -o json | jq -r --arg c "$pvc" \
      '.items[] | select([.spec.volumes[]?.persistentVolumeClaim.claimName] | index($c)) | .metadata.name')" ]; do
      sleep 2
    done
  done

  log "$ns" "4: delete PVC and PV objects (data stays)"
  for pvc in "${!old[@]}"; do
    kubectl delete pvc -n "$ns" "$pvc" --ignore-not-found --wait=true >/dev/null
    for pv in $(kubectl get pv -o json | jq -r --arg ns "$ns" --arg c "$pvc" \
      '.items[] | select(.spec.claimRef.namespace == $ns and .spec.claimRef.name == $c) | .metadata.name'); do
      kubectl delete pv "$pv" --wait=true >/dev/null
    done
  done

  log "$ns" "5: rename on nas"
  declare -A count=()
  script='set -eu'
  for pvc in "${!old[@]}"; do
    script+="
o=/k8s/${old[$pvc]} n=/k8s/$ns-$pvc
[ ! -e \"\$n\" ] || { echo \"exists \$n\" >&2; exit 1; }
c=\$(find \"\$o\" | wc -l)
mv \"\$o\" \"\$n\"
echo \"$pvc \$c\""
  done
  while read -r pvc c; do count[$pvc]=$c; echo "   ${old[$pvc]} -> $ns-$pvc ($c entries)"; done \
    < <(nas_job "$ns" nfs-stable-paths "$script")

  log "$ns" "6: restore replicas, resume and sync"
  for t in "${!replicas[@]}"; do
    kubectl patch -n "$ns" "$t" --type merge -p "{\"spec\":{\"replicas\":${replicas[$t]}}}" >/dev/null
  done
  kubectl patch application -n argocd "$ns" --type merge \
    -p '{"spec":{"syncPolicy":{"automated":{"enabled":true}}},"operation":{"initiatedBy":{"username":"nfs-stable-paths"},"sync":{}}}' >/dev/null

  log "$ns" "7: verify"
  fail=0
  for pvc in "${!old[@]}"; do
    for _ in $(seq 100); do
      [ "$(kubectl get pvc -n "$ns" "$pvc" -o jsonpath='{.status.phase}' 2>/dev/null)" = Bound ] && break
      sleep 3
    done
    pv=$(kubectl get pvc -n "$ns" "$pvc" -o jsonpath='{.spec.volumeName}')
    path=$(kubectl get pv "$pv" -o jsonpath='{.spec.nfs.path}')
    [ "$path" = "$root/$ns-$pvc" ] && echo "   ok   $pvc -> $path" || { echo "   FAIL $pvc -> $path"; fail=1; }
  done
  script='set -eu'
  for pvc in "${!old[@]}"; do script+="
echo \"$pvc \$(find /k8s/$ns-$pvc | wc -l)\""; done
  while read -r pvc c; do
    # The app may have written since; fewer entries than before is the failure.
    [ "$c" -ge "${count[$pvc]}" ] && echo "   ok   $pvc: $c entries (was ${count[$pvc]})" \
      || { echo "   FAIL $pvc: $c entries (was ${count[$pvc]})"; fail=1; }
  done < <(nas_job "$ns" nfs-stable-paths-verify "$script")
  for t in "${!replicas[@]}"; do
    case $t in
      deployment/* | statefulset/*) kubectl rollout status -n "$ns" "$t" --timeout=10m >/dev/null && echo "   ok   $t ready" || { echo "   FAIL $t not ready"; fail=1; } ;;
      *) kubectl wait -n "$ns" --for=condition=Available "$t" --timeout=10m >/dev/null && echo "   ok   $t available" || { echo "   FAIL $t not available"; fail=1; } ;;
    esac
  done
  [ $fail = 0 ] || { echo "nfs-stable-paths: $ns failed verification; rerun resumes" >&2; exit 1; }
  kubectl delete configmap -n "$ns" "$state" >/dev/null
  unset old replicas count
done
