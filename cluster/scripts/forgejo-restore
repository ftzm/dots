#!/usr/bin/env bash
# Restore Forgejo from a nightly `forgejo dump` (FORGEJO_MIGRATION_PLAN.md ->
# Restore Runbook, steps 0-7, 9 and the API checks of step 10). The one-time
# bootstrap exception to "no manual kubectl".
#
#   forgejo-restore --restore --refs-url URL --refs-url-local URL [--compare-live]
#       the real thing, in namespace forgejo: refs from URL/<owner>/<repo>.git
#       inside the cluster (step 4) and URL-local from this workstation (step
#       7) -- the nas mirror (and PR branches merged into it beforehand);
#       --compare-live also checks open PRs against forgejo.lan (rehearsals)
#   forgejo-restore --rehearse
#       into a scratch namespace (forgejo-restore-test) beside the live
#       instance, which is the refs source and the comparison
#   forgejo-restore --rehearse --cleanup
#       delete the scratch namespace and PV
#
# Steps (runbook numbering):
#   0  (--restore) pause the Forgejo Application's automated sync; delete the
#      IngressRoute and the ssh NodePort Service (quarantine, step 6)
#   1  pick the newest forgejo-*.tar on the dump share; integrity-check its raw
#      gitea.db before trusting it
#   2  Forgejo scaled to 0 (the scratch copy starts at 0)
#   3  a Job empties the data volume (a fresh install's -wal would be replayed
#      into the restored DB) and extracts data/ into /data/gitea and repos/
#      into /data/git/repositories, as uid 1000
#   4  refs current on disk before anything runs: each repo's branches fetched
#      straight into its bare repo from the refs source
#   5  keys and hooks regenerated by the running Forgejo itself: the extract
#      removes authorized_keys (Forgejo writes it on start; a copy written
#      outside the Deployment's FORGEJO__* environment differs line by line
#      and Forgejo refuses to start), and `doctor check --all --fix` rewrites
#      the repo hooks (16.x has no `admin regenerate hooks`)
#   6  start quarantined: no Service or IngressRoute, so no runner reaches it;
#      Actions on, since with them off the Actions API is not served
#   7  replay through Forgejo: push every branch from a clone of the refs
#      source over a port-forward, through its own push path; mark PRs merged
#      after the dump as manually merged; cancel every waiting, blocked or
#      running Actions run (the dump's queue and the CI the replay queued)
#   9  (--restore) resume automated sync and sync: IngressRoute and Service
#      back
#   10 verify: branches equal the refs source's, no run waiting, blocked or
#      running; with --compare-live (or --rehearse) open PRs equal live's
#
# Run in the cluster dev shell, with $KUBECONFIG set and bin/forgejo-api's
# token (the restored DB is the dump's, so the token is valid there too).
set -euo pipefail

repo_dir=$(cd "$(dirname "$0")/../.." && pwd)
api="$repo_dir/bin/forgejo-api"
src_ns=forgejo
nfs_server=192.168.1.3
nfs_path=/pool-1/k8s/forgejo-backup
live=https://forgejo.lan.ftzmlab.xyz
usage="usage: $0 --restore --refs-url URL --refs-url-local URL [--compare-live] | --rehearse [--cleanup]"

mode='' refs_url='' refs_local='' compare=''
while [ $# -gt 0 ]; do
  case $1 in
    --restore | --rehearse) mode=${1#--} ;;
    --refs-url) refs_url=$2; shift ;;
    --refs-url-local) refs_local=$2; shift ;;
    --compare-live) compare=1 ;;
    --cleanup) cleanup=1 ;;
    *) echo "$usage" >&2; exit 2 ;;
  esac
  shift
done
case $mode in
  rehearse)
    ns=forgejo-restore-test dump_pvc=forgejo-dump compare=1
    refs_url=http://forgejo.$src_ns.svc:3000 refs_local=$live
    if [ -n "${cleanup:-}" ]; then
      kubectl delete namespace "$ns" --ignore-not-found
      kubectl delete pv forgejo-restore-test-dump --ignore-not-found
      exit 0
    fi ;;
  restore)
    ns=forgejo dump_pvc=forgejo-backup
    [ -n "$refs_url" ] && [ -n "$refs_local" ] || { echo "$usage" >&2; exit 2; } ;;
  *) echo "$usage" >&2; exit 2 ;;
esac
# Forgejo wants its token on HTTP(S) refs sources; the nas mirror is ssh/git.
case $refs_url in http*) http_refs=1 ;; *) http_refs= ;; esac

start=$(date +%s)
log() { echo "[$(( $(date +%s) - start ))s] $*"; }
job() { # <name> <script>: run a script in a Job mounting data and dump, wait
  local name=$1 script=$2
  kubectl delete job -n "$ns" "$name" --ignore-not-found >/dev/null
  kubectl apply -f - >/dev/null <<EOF
apiVersion: batch/v1
kind: Job
metadata: { name: $name, namespace: $ns }
spec:
  backoffLimit: 0
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: run
          image: $image
          command: [/bin/bash, -c]
          args: [$(jq -Rs . <<<"$script")]
          env: [$( [ -n "$http_refs" ] && echo '{ name: TOKEN, valueFrom: { secretKeyRef: { name: restore-refs-token, key: token } } }' )]
          volumeMounts:
            - { name: data, mountPath: /data }
            - { name: dump, mountPath: /dump, readOnly: true }
      volumes:
        - { name: data, persistentVolumeClaim: { claimName: forgejo-data } }
        - { name: dump, persistentVolumeClaim: { claimName: $dump_pvc } }
EOF
  local st=''
  for _ in $(seq 300); do # `kubectl wait --for=condition=complete` never sees a failure
    st=$(kubectl get job -n "$ns" "$name" -o jsonpath='{.status.succeeded}/{.status.failed}')
    case $st in 1/*) break ;; */[1-9]*) break ;; esac
    sleep 3
  done
  case $st in
    1/*) ;;
    *) kubectl logs -n "$ns" "job/$name" >&2 || true
       echo "forgejo-restore: job $name did not succeed ($st)" >&2
       exit 1 ;;
  esac
  kubectl logs -n "$ns" "job/$name"
}

image=$(kubectl get deploy -n "$src_ns" forgejo -o jsonpath='{.spec.template.spec.containers[0].image}')

if [ "$mode" = restore ]; then
# --- 0. pause, quarantine ------------------------------------------------------
log "step 0: pause the forgejo Application's automated sync; quarantine"
kubectl patch application -n argocd forgejo --type merge \
  -p '{"spec":{"syncPolicy":{"automated":{"enabled":false}}}}' >/dev/null
kubectl delete ingressroute -n "$ns" forgejo --ignore-not-found >/dev/null
kubectl delete service -n "$ns" forgejo-ssh --ignore-not-found >/dev/null
log "step 2: stop Forgejo"
kubectl scale -n "$ns" deploy/forgejo --replicas=0 >/dev/null
kubectl wait -n "$ns" --for=delete pod -l app.kubernetes.io/name=forgejo --timeout=300s >/dev/null 2>&1 || true
else
# --- scratch instance (rehearsal only) ----------------------------------------
log "scratch instance in $ns ($image)"
kubectl create namespace "$ns" --dry-run=client -o yaml | kubectl apply -f - >/dev/null
kubectl get secret -n "$src_ns" forgejo-secrets -o json \
  | jq --arg ns "$ns" '{apiVersion, kind, type, data, metadata: {name: .metadata.name, namespace: $ns}}' \
  | kubectl apply -f - >/dev/null
kubectl apply -f - >/dev/null <<EOF
apiVersion: v1
kind: PersistentVolume
metadata: { name: forgejo-restore-test-dump }
spec:
  capacity: { storage: 10Gi }
  accessModes: [ReadOnlyMany]
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  claimRef: { namespace: $ns, name: forgejo-dump }
  nfs: { server: $nfs_server, path: $nfs_path, readOnly: true }
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata: { name: forgejo-dump, namespace: $ns }
spec:
  accessModes: [ReadOnlyMany]
  storageClassName: ""
  volumeName: forgejo-restore-test-dump
  resources: { requests: { storage: 10Gi } }
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata: { name: forgejo-data, namespace: $ns }
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: local-path
  resources: { requests: { storage: 20Gi } }
EOF
# A copy of the live Deployment at 0 replicas (step 2). No Service, no
# IngressRoute (step 6).
kubectl get deploy -n "$src_ns" forgejo -o json | jq --arg ns "$ns" '
  {apiVersion, kind,
   metadata: {name: .metadata.name, namespace: $ns},
   spec: (.spec | .replicas = 0)}' \
  | kubectl apply -f - >/dev/null
fi
# The token file ends in a newline; in an http.extraHeader it makes Forgejo
# answer 400 to git's POSTs.
if [ -n "$http_refs" ]; then
  tr -d '\n' <"$HOME/.config/forgejo/claude-token" \
    | kubectl create secret generic -n "$ns" restore-refs-token --from-file=token=/dev/stdin \
      --dry-run=client -o yaml | kubectl apply -f - >/dev/null
fi

# --- 1. pick the dump ---------------------------------------------------------
log "step 1: newest dump, integrity check"
dump=$(job restore-pick '
  set -euo pipefail
  d=$(ls -1t /dump/forgejo-*.tar | head -1)
  mkdir -p /tmp/x && cd /tmp/x
  tar -xf "$d" data/gitea.db data/gitea.db-wal data/gitea.db-shm 2>/dev/null || tar -xf "$d" data/gitea.db
  r=$(sqlite3 data/gitea.db "PRAGMA integrity_check")
  [ "$r" = ok ] || { echo "integrity_check: $r" >&2; exit 1; }
  echo "$d"
' | tail -1)
log "dump: $dump (integrity ok)"

# --- 3. restore into the PVC -------------------------------------------------
log "step 3: extract data/ and repos/ into the data volume"
job restore-extract "
  set -euo pipefail
  mkdir -p /tmp/x && cd /tmp/x && tar -xf $dump
  find /data -mindepth 1 -maxdepth 1 -exec rm -rf {} +
  mkdir -p /data/gitea /data/git/repositories
  cp -a data/. /data/gitea/
  cp -a repos/. /data/git/repositories/
  chown -R 1000:1000 /data/gitea /data/git
  echo restored: \$(ls /data/git/repositories/*/ | tr '\n' ' ')
"

# --- 4. refs current on disk ---------------------------------------------------
log "step 4: refs current from $refs_url, fetched into each bare repo"
job restore-refs "
  set -euo pipefail
  for r in /data/git/repositories/*/*.git; do
    owner=\$(basename \$(dirname \$r)); name=\$(basename \$r .git)
    g=(su-exec git git -C \$r \${TOKEN:+-c http.extraHeader=\"Authorization: token \$TOKEN\"})
    src=$refs_url/\$owner/\$name.git
    # The nas mirror holds dots only; other repos keep the dump's refs.
    if ! err=\$(\"\${g[@]}\" ls-remote --heads \$src 2>&1 >/dev/null); then
      echo \"refs: \$owner/\$name not in the refs source, kept from the dump (\$err)\"
      continue
    fi
    \"\${g[@]}\" fetch --quiet --prune \$src '+refs/heads/*:refs/heads/*'
    echo \"refs: \$owner/\$name\"
  done
"

# --- 6. start quarantined -----------------------------------------------------
log "step 6: start Forgejo quarantined (no IngressRoute, no ssh Service)"
kubectl scale -n "$ns" deploy/forgejo --replicas=1 >/dev/null
if ! kubectl rollout status -n "$ns" deploy/forgejo --timeout=300s >/dev/null; then
  kubectl logs -n "$ns" deploy/forgejo -c forgejo --tail=20 >&2 || true
  echo "forgejo-restore: Forgejo did not start" >&2
  exit 1
fi
log "step 5: hooks rewritten by doctor --fix in the running Forgejo"
kubectl exec -n "$ns" deploy/forgejo -c forgejo -- \
  su-exec git forgejo doctor check --all --fix --config /data/gitea/conf/app.ini >/dev/null

# --- 7. replay through Forgejo -------------------------------------------------
log "step 7: replay every branch through Forgejo's push path"
port=13000
kubectl port-forward -n "$ns" deploy/forgejo "$port:3000" >/dev/null 2>&1 &
pf=$!
trap 'kill $pf 2>/dev/null || true' EXIT
until curl -sf "http://127.0.0.1:$port/api/v1/version" >/dev/null; do sleep 1; done
restored="http://127.0.0.1:$port/api/v1"
work=$(mktemp -d)
token=$(tr -d '\n' <"$HOME/.config/forgejo/claude-token")
auth=(-c http.extraHeader="Authorization: token $token")
for repo in $(FORGEJO_URL=$restored "$api" GET '/repos/search?limit=50' | jq -r '.data[].full_name'); do
  git "${auth[@]}" clone --quiet --mirror "$refs_local/$repo.git" "$work/$repo.git" 2>/dev/null \
    || echo "no refs source for $repo: kept from the dump"
done
for repo in $(FORGEJO_URL=$restored "$api" GET '/repos/search?limit=50' | jq -r '.data[] | select(.mirror | not) | .full_name'); do
  [ -d "$work/$repo.git" ] || continue
  git -C "$work/$repo.git" "${auth[@]}" \
    push --quiet "http://127.0.0.1:$port/$repo.git" '+refs/heads/*:refs/heads/*'
  echo "replayed $repo"
done
unset token auth
# PRs merged after the dump are still open in its DB, and the replay cannot
# flip them: step 4 left the refs current, so its pushes change nothing and
# queue no PR check (and detection needs AutodetectManualMerge, off by
# default). Mark each open PR whose head its base branch contains as manually
# merged, at the oldest first-parent base commit containing it (the merge).
# The style is enabled for this; step 8's OpenTofu re-asserts repo settings.
for repo in $(FORGEJO_URL=$restored "$api" GET '/repos/search?limit=50' | jq -r '.data[] | select(.mirror | not) | .full_name'); do
  FORGEJO_URL=$restored "$api" GET "/repos/$repo/pulls?state=open&limit=50" \
    | jq -r '.[] | "\(.number) \(.head.sha) \(.base.ref)"' \
    | while read -r n head base; do
        [ -d "$work/$repo.git" ] || continue
        g=(git -C "$work/$repo.git")
        "${g[@]}" merge-base --is-ancestor "$head" "refs/heads/$base" 2>/dev/null || continue
        merge=$("${g[@]}" rev-list --first-parent --ancestry-path "$head..refs/heads/$base" | tail -1)
        [ -n "$merge" ] || merge=$head # fast-forward: the head is on base itself
        FORGEJO_URL=$restored "$api" PATCH "/repos/$repo" '{"allow_manual_merge":true}' >/dev/null
        FORGEJO_URL=$restored "$api" POST "/repos/$repo/pulls/$n/merge" \
          "{\"Do\":\"manually-merged\",\"MergeCommitID\":\"$merge\"}" >/dev/null
        echo "marked $repo#$n merged at ${merge:0:8} (merged after the dump)"
      done
done
unfinished='status=waiting&status=blocked&status=running'
for repo in $(FORGEJO_URL=$restored "$api" GET '/repos/search?limit=50' | jq -r '.data[] | select(.has_actions) | .full_name'); do
  ids=$(FORGEJO_URL=$restored "$api" GET "/repos/$repo/actions/runs?$unfinished&limit=50" | jq -r '.workflow_runs[].id')
  for id in $ids; do
    FORGEJO_URL=$restored "$api" POST "/repos/$repo/actions/runs/$id/cancel" >/dev/null
    echo "cancelled $repo run $id"
  done
done

if [ "$mode" = restore ]; then
# --- 9. expose and resume ------------------------------------------------------
log "step 9: resume automated sync and sync (IngressRoute, ssh Service back)"
kubectl patch application -n argocd forgejo --type merge \
  -p '{"spec":{"syncPolicy":{"automated":{"enabled":true}}},"operation":{"initiatedBy":{"username":"forgejo-restore"},"sync":{}}}' >/dev/null
for _ in $(seq 120); do
  phase=$(kubectl get application -n argocd forgejo -o jsonpath='{.status.operationState.phase}')
  [ "$phase" = Running ] || break
  sleep 5
done
kubectl get application -n argocd forgejo -o jsonpath='{.status.sync.status} {.status.health.status} op={.status.operationState.phase}{"\n"}'
kubectl get ingressroute -n "$ns" forgejo -o name
kubectl get service -n "$ns" forgejo-ssh -o name
fi

# --- 10. verify ----------------------------------------------------------------
log "step 10: verify"
fail=0
for repo in $(FORGEJO_URL=$restored "$api" GET '/repos/search?limit=50' | jq -r '.data[] | select(.mirror | not) | .full_name'); do
  [ -d "$work/$repo.git" ] || { echo "--   $repo: no refs source, as dumped"; continue; }
  a=$(git -C "$work/$repo.git" for-each-ref --format='%(refname:lstrip=2) %(objectname)' refs/heads | sort)
  b=$(FORGEJO_URL=$restored "$api" GET "/repos/$repo/branches?limit=50" | jq -r '.[] | "\(.name) \(.commit.id)"' | sort)
  [ "$a" = "$b" ] && echo "ok   $repo branches match the refs source" || { echo "FAIL $repo branches differ from the refs source"; fail=1; }
  [ -n "$compare" ] || continue
  a=$("$api" GET "/repos/$repo/pulls?state=open" | jq -r '.[].number' | sort)
  b=$(FORGEJO_URL=$restored "$api" GET "/repos/$repo/pulls?state=open" | jq -r '.[].number' | sort)
  [ "$a" = "$b" ] && echo "ok   $repo open PRs match live (${b:-none})" || { echo "FAIL $repo open PRs: live '$a', restored '$b'"; fail=1; }
done
for repo in $(FORGEJO_URL=$restored "$api" GET '/repos/search?limit=50' | jq -r '.data[] | select(.has_actions) | .full_name'); do
  n=$(FORGEJO_URL=$restored "$api" GET "/repos/$repo/actions/runs?$unfinished" | jq -r '.total_count')
  [ "$n" = 0 ] && echo "ok   $repo no unfinished Actions runs" || { echo "FAIL $repo has $n unfinished Actions runs"; fail=1; }
done
log "done (fail=$fail)"
exit $fail
