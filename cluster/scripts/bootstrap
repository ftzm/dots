#!/usr/bin/env bash
# Bootstrap a k3s cluster (fresh, or the one-time cut-over from the single
# `lab` Application) up to the point where ArgoCD deploys everything else
# (FORGEJO_MIGRATION_PLAN.md -> Cluster Bootstrap). Every object applied is a
# committed file that ArgoCD adopts unchanged, or a backed-up sealing key;
# this is the one-time-bootstrap exception to "no manual kubectl apply".
#
# Run in the cluster dev shell (`cd cluster && nix develop --command
# scripts/bootstrap`; it supplies kubectl and yq-go), against the cluster in
# $KUBECONFIG, on a workstation with agenix and the agenix master key
# (`personal` in secrets/secrets.nix).
#
#  1. Sealing keys before the controller. The backed-up controller keys
#     (secrets/sealed-secrets-keys.age, every key the controller ever made;
#     renewal is off) are applied as the labelled key Secrets, then the
#     sealed-secrets CRD and controller. Reversed, the controller generates a
#     fresh key on first start and no existing SealedSecret decrypts -- so
#     the script asserts every key is present before the controller
#     Deployment is applied.
#  1b. The SOPS age key (secrets/sops-age-key.age) as sops-operator's
#     sops-age-key Secret, before ArgoCD starts the operator.
#  2. ArgoCD: a server-side apply of cluster/manifests/argocd/ -- ArgoCD's
#     install, the self-managing `argocd` Application, the operator
#     Applications and the services ApplicationSet -- CRDs first, then the
#     namespace, then the rest except kinds whose operators ArgoCD deploys.
#     From then on the `argocd` Application manages that directory and its
#     sync waves bring up the rest (ARGOCD_APPLICATIONS_PLAN.md).
#
# Committed manifests are applied with ArgoCD's own field manager,
# argocd-controller, so each apply is exactly what the owning Application's
# first sync of the same directory writes. As the default `kubectl` manager it
# conflicts with fields ArgoCD already owns on a live cluster, and forcing
# those would leave `kubectl` co-owning every field here -- server-side apply
# removes a field only once no manager owns it, so a field later dropped from
# the chart would stay. The key Secrets are in no Application (they are not in
# git), so ArgoCD neither tracks nor prunes them.
set -euo pipefail

for tool in kubectl agenix yq; do
  command -v "$tool" >/dev/null || { echo "bootstrap: $tool not on PATH" >&2; exit 1; }
done

repo_dir=$(cd "$(dirname "$0")/../.." && pwd)
cluster_dir=$repo_dir/cluster
ss_dir=$cluster_dir/manifests/sealed-secrets
ss_ns=sealed-secrets
key_label=sealedsecrets.bitnami.com/sealed-secrets-key
apply=(kubectl apply --server-side --field-manager=argocd-controller)

# --- 1. Sealing keys, then the sealed-secrets controller ---------------------

# agenix resolves the file against ./secrets.nix. Server-set metadata is
# dropped so the keys create cleanly on a fresh cluster; the labels, which
# make the controller load them, are kept.
keys=$(cd "$repo_dir/secrets" && agenix -d sealed-secrets-keys.age |
  yq 'del(.items[].metadata.resourceVersion, .items[].metadata.uid,
          .items[].metadata.creationTimestamp, .items[].metadata.managedFields,
          .items[].metadata.ownerReferences)')
want=$(yq '[.items[] | select(.metadata.labels["'"$key_label"'"] == "active")] | length' <<<"$keys")
[ "$want" -gt 0 ] || { echo "bootstrap: no labelled key in the backup" >&2; exit 1; }

"${apply[@]}" -f "$ss_dir/sealed-secrets-namespace.yaml"
kubectl apply --server-side -f - <<<"$keys"

have=$(kubectl get secret -n "$ss_ns" -l "$key_label=active" -o name | wc -l)
if [ "$have" -lt "$want" ]; then
  echo "bootstrap: $have of $want sealing keys present; not starting the controller" >&2
  exit 1
fi
echo "bootstrap: $have sealing keys present"

"${apply[@]}" -f "$ss_dir/"
kubectl rollout status -n "$ss_ns" deploy/sealed-secrets --timeout=5m

# --- 1b. The SOPS age key ----------------------------------------------------

# sops-operator decrypts every SopsSecret with it (SOPS_AGE_KEY_FILE
# /mnt/age/key). Not in git and in no Application, like the sealing keys;
# without it no SopsSecret becomes a Secret. Created only when missing.
"${apply[@]}" -f "$cluster_dir/manifests/sops-operator/sops-operator-namespace.yaml"
if ! kubectl get secret -n sops-operator sops-age-key >/dev/null 2>&1; then
  (cd "$repo_dir/secrets" && agenix -d sops-age-key.age) |
    kubectl create secret generic -n sops-operator sops-age-key --from-file=key=/dev/stdin
fi

# --- 2. ArgoCD ---------------------------------------------------------------

# In three passes; one apply of the directory fails on a fresh cluster:
# kubectl resolves every kind before the CRDs in the same apply exist, and
# applies files alphabetically, the namespace after most of its objects.
argocd_dir=$cluster_dir/manifests/argocd
crds=() rest=()
for f in "$argocd_dir"/*.yaml; do
  [ "$(yq '.kind' "$f")" = CustomResourceDefinition ] && crds+=(-f "$f")
done
"${apply[@]}" "${crds[@]}"
kubectl wait --for=condition=Established --timeout=2m "${crds[@]}" >/dev/null
"${apply[@]}" -f "$argocd_dir/argocd-namespace.yaml"
# redis's password, read by every ArgoCD component. The chart's
# redisSecretInit Job would create it but is disabled (lab.jsonnet), so a
# fresh cluster has none and redis never starts. Cluster-local like the
# sealing keys: in no Application, never replaced once it exists.
if ! kubectl get secret -n argocd argocd-redis >/dev/null 2>&1; then
  head -c 24 /dev/urandom | base64 | tr -d '\n' |
    kubectl create secret generic -n argocd argocd-redis --from-file=auth=/dev/stdin
fi
# The rest, except kinds not yet served: the ServiceMonitors, PrometheusRule
# and IngressRouteTCP come from operators ArgoCD itself deploys (waves 3-4);
# the argocd Application creates them in wave 5.
served=$(kubectl api-resources --no-headers | awk '{print $NF}' | sort -u)
for f in "$argocd_dir"/*.yaml; do
  kind=$(yq '.kind' "$f")
  [ "$kind" = CustomResourceDefinition ] && continue
  if ! grep -qx "$kind" <<<"$served"; then
    echo "bootstrap: $(basename "$f"): $kind not served yet, left to the argocd Application"
    continue
  fi
  rest+=(-f "$f")
done
"${apply[@]}" "${rest[@]}"
for d in $(kubectl get deploy -n argocd -o name); do
  kubectl rollout status -n argocd "$d" --timeout=5m
done
kubectl rollout status -n argocd statefulset/argocd-application-controller --timeout=5m
